
{
  "name": "dhan-paper-backend-2026",
  "main": "worker.js",
  "compatibility_date": "2026-11-27",
  "durable_objects": {
    "bindings": [
      {
        "name": "DHAN_LIVE",
        "class_name": "DhanLive"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DhanLive"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
